# Public site origin, used for canonical URLs, Open Graph, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.jnroslogistics.example

# Where quote and contact form submissions are POSTed as JSON (Zapier, Make, a Slack/Teams
# workflow, your CRM or your own API). Without it, submissions are acknowledged to the visitor
# but only a PII-free line is logged on the server.
FORMS_WEBHOOK_URL=
